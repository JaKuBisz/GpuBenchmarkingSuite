<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Optimize>true</Optimize>
        <Platforms>x64</Platforms>
        <!-- Suppress CA1416 — WMI calls are guarded by RuntimeInformation.IsOSPlatform -->
        <NoWarn>CA1416</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ILGPU" Version="1.5.3" />
      <PackageReference Include="ILGPU.Algorithms" Version="1.5.3" />
      <PackageReference Include="ComputeSharp" Version="3.1.0" />
    </ItemGroup>

    <!-- System.Management is Windows-only; included for CPU/GPU info via WMI -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <PackageReference Include="System.Management" Version="10.0.5" />
    </ItemGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
        <_Parameter1>GpuBenchmarks.Tests</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
